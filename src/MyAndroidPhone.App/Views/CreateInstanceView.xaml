<UserControl
    x:Class="MyAndroidPhone.Desktop.Views.CreateInstanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MyAndroidPhone.Desktop.ViewModels"
    xmlns:views="using:MyAndroidPhone.Desktop.Views"
    xmlns:h="using:MyAndroidPhone.Desktop.Helpers">

    <Grid Padding="24" RowSpacing="14" Width="680" Height="580">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="{x:Bind ViewModel.StepTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
            <ProgressBar Minimum="1" Maximum="{x:Bind ViewModel.StepCount, Mode=OneWay}" Value="{x:Bind ViewModel.StepNumber, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <!-- Step 1: license -->
            <ScrollViewer Visibility="{x:Bind h:Converters.StepVisibility(ViewModel.StepIndex, 0), Mode=OneWay}">
                <StackPanel Spacing="10" Padding="0,0,12,0">
                    <TextBlock Text="Security and privacy" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SecurityNotice}" TextWrapping="Wrap" />
                    <TextBlock Text="Application license" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.ApplicationLicenseStatement}" TextWrapping="Wrap" />
                    <TextBlock Text="Third-party components" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.8" Text="These components keep their own licenses. Follow the links for the full terms." />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Notices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NoticeViewModel">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{x:Bind Component}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind License}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Note}" TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <HyperlinkButton Content="{x:Bind LinkText}" NavigateUri="{x:Bind Link}" Padding="0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Step 2: connect -->
            <ScrollViewer Visibility="{x:Bind h:Converters.StepVisibility(ViewModel.StepIndex, 1), Mode=OneWay}">
                <StackPanel Spacing="12" Padding="0,0,12,0">
                    <InfoBar IsOpen="{x:Bind ViewModel.HasAdbProblem, Mode=OneWay}" IsClosable="False" Severity="Warning"
                             Title="Android Debug Bridge (adb) is needed"
                             Message="Select adb.exe from Android SDK Platform-Tools to connect a phone." />
                    <views:ToolCard Item="{x:Bind ViewModel.AdbItem, Mode=OneWay}" Visibility="{x:Bind h:Converters.ToVisibility(ViewModel.HasAdbProblem), Mode=OneWay}" />

                    <RadioButtons SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}" MaxColumns="2" AutomationProperties.Name="Connection type">
                        <RadioButton Content="USB cable" />
                        <RadioButton Content="Network (Wi-Fi)" />
                    </RadioButtons>

                    <StackPanel Spacing="8" Visibility="{x:Bind h:Converters.ToVisibility(ViewModel.IsUsbMode), Mode=OneWay}">
                        <TextBlock TextWrapping="Wrap" Opacity="0.85"
                                   Text="Turn on Developer options (Settings > About phone, tap Build number 7 times), then USB debugging. Plug in the cable and tap Allow on the phone's debugging prompt." />
                    </StackPanel>

                    <StackPanel Spacing="8" Visibility="{x:Bind h:Converters.ToVisibility(ViewModel.IsNetworkMode), Mode=OneWay}">
                        <TextBlock TextWrapping="Wrap" Opacity="0.85"
                                   Text="Phone and computer must be on the same network. On Android 11 or later open Developer options > Wireless debugging. If the phone was never paired with this computer, pair it first." />
                        <Expander Header="Pair first (Android 11 or later)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBox Header="Pairing address (from 'Pair device with pairing code')" PlaceholderText="192.168.1.20:37215" Text="{x:Bind ViewModel.PairEndpoint, Mode=TwoWay}" />
                                <PasswordBox Header="Six-digit pairing code" Password="{x:Bind ViewModel.PairCode, Mode=TwoWay}" MaxLength="6" />
                                <Button Content="Pair" Command="{x:Bind ViewModel.PairCommand}" IsEnabled="{x:Bind h:Converters.Not(ViewModel.IsBusy), Mode=OneWay}" />
                            </StackPanel>
                        </Expander>
                        <TextBox Header="Connect address (shown on the Wireless debugging screen)" PlaceholderText="192.168.1.20:41231" Text="{x:Bind ViewModel.Endpoint, Mode=TwoWay}" />
                        <Button Content="Connect" Command="{x:Bind ViewModel.ConnectCommand}" IsEnabled="{x:Bind h:Converters.Not(ViewModel.IsBusy), Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.ConnectStatus, Mode=OneWay}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Phones found" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Content="Check again" Command="{x:Bind ViewModel.RefreshDevicesCommand}" />
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.DeviceListHint, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" />
                    <ListView ItemsSource="{x:Bind ViewModel.Devices}" SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}" SelectionMode="Single"
                              AutomationProperties.Name="Phones found">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceItemViewModel">
                                <StackPanel Padding="0,6">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                    <TextBlock Text="{x:Bind Guidance}" TextWrapping="Wrap" Opacity="0.85" Style="{StaticResource CaptionTextBlockStyle}"
                                               Visibility="{x:Bind h:Converters.ToVisibility(HasGuidance)}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Opacity="0.8" TextWrapping="Wrap" Text="Only phones that are ready (debugging allowed on the phone) can be selected." />
                </StackPanel>
            </ScrollViewer>

            <!-- Step 3: personalize -->
            <ScrollViewer Visibility="{x:Bind h:Converters.StepVisibility(ViewModel.StepIndex, 2), Mode=OneWay}">
                <StackPanel Spacing="14" Padding="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{x:Bind ViewModel.PreviewBrush, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind ViewModel.PreviewGlyph, Mode=OneWay}" FontSize="30" Foreground="White" />
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.PreviewName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBox Header="Name" MaxLength="40" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" AutomationProperties.Name="Instance name" />

                    <TextBlock Text="Icon" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <GridView ItemsSource="{x:Bind ViewModel.IconChoices}" SelectedIndex="{x:Bind ViewModel.IconIndex, Mode=TwoWay}" SelectionMode="Single"
                              AutomationProperties.Name="Icon">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:IconChoice">
                                <StackPanel Width="84" Padding="0,8" Spacing="4" ToolTipService.ToolTip="{x:Bind Name}">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="26" />
                                    <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <TextBlock Text="Accent color" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <GridView ItemsSource="{x:Bind ViewModel.AccentChoices}" SelectedIndex="{x:Bind ViewModel.AccentIndex, Mode=TwoWay}" SelectionMode="Single"
                              AutomationProperties.Name="Accent color">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccentChoice">
                                <Ellipse Width="28" Height="28" Fill="{x:Bind Brush}" ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}" Margin="4" />
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <RadioButtons Header="Theme" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" MaxColumns="3">
                        <RadioButton Content="Dark" />
                        <RadioButton Content="Light" />
                        <RadioButton Content="Follow system" />
                    </RadioButtons>

                    <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
            <Button Grid.Column="2" Content="Back" Command="{x:Bind ViewModel.BackCommand}" IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" />
            <StackPanel Grid.Column="3">
                <Button Content="Accept and continue" Command="{x:Bind ViewModel.AcceptCommand}" Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind h:Converters.ToVisibility(ViewModel.ShowAccept), Mode=OneWay}" />
                <Button Content="Next" Command="{x:Bind ViewModel.NextCommand}" Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" Visibility="{x:Bind h:Converters.ToVisibility(ViewModel.ShowNext), Mode=OneWay}" />
                <Button Content="Create and open" Command="{x:Bind ViewModel.CreateCommand}" Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind h:Converters.ToVisibility(ViewModel.ShowCreate), Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

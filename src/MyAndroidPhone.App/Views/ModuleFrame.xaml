<UserControl
    x:Class="MyAndroidPhone.Desktop.Views.ModuleFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Floating module window chrome: draggable title bar, close button, rounded themed surface. -->
    <Border CornerRadius="12" BorderThickness="1"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="TitleBar" Padding="14,6,6,6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button x:Name="CloseButton" Grid.Column="1" Padding="8,4" Background="Transparent" BorderThickness="0"
                        Click="OnCloseClicked" ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
            <ContentPresenter x:Name="Presenter" Grid.Row="1" />
        </Grid>
    </Border>
</UserControl>

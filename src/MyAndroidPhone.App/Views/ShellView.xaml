<UserControl
    x:Class="MyAndroidPhone.Desktop.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MyAndroidPhone.Desktop.ViewModels"
    xmlns:h="using:MyAndroidPhone.Desktop.Helpers">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu bar -->
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="My Android Phone">
                <MenuFlyoutItem Text="Run setup again…" Click="OnRerunSetup" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="OnExit" />
            </MenuBarItem>
            <MenuBarItem x:Name="ToolsMenu" Title="Modules" />
            <MenuBarItem Title="View">
                <MenuFlyoutSubItem Text="Theme">
                    <MenuFlyoutItem Text="Dark" Click="OnThemeDark" />
                    <MenuFlyoutItem Text="Light" Click="OnThemeLight" />
                    <MenuFlyoutItem Text="Follow system" Click="OnThemeSystem" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="Close all windows" Click="OnCloseAll" />
            </MenuBarItem>
        </MenuBar>

        <!-- Device selector and tool status -->
        <Border Grid.Row="1" Padding="16,8" CornerRadius="10" Margin="12,4,12,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8EA;" FontSize="16" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.Devices}" SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                              PlaceholderText="No device" MinWidth="300" AutomationProperties.Name="Target device">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceItemViewModel">
                                <TextBlock Text="{x:Bind Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Device Center" Click="OnOpenDeviceCenter" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DeviceStatus, Mode=OneWay}" VerticalAlignment="Center"
                           Opacity="0.8" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ToolSummary, Mode=OneWay}" VerticalAlignment="Center"
                           Opacity="0.7" TextTrimming="CharacterEllipsis" MaxWidth="360" />
            </Grid>
        </Border>

        <!-- Workspace: module windows float here -->
        <Grid Grid.Row="2" Margin="12">
            <Border CornerRadius="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <TextBlock x:Name="EmptyHint" Text="Open a module from the Dock below." HorizontalAlignment="Center"
                           VerticalAlignment="Center" Opacity="0.55" />
            </Border>
            <Canvas x:Name="Workspace" SizeChanged="OnWorkspaceSizeChanged" />
            <StackPanel x:Name="NotificationHost" VerticalAlignment="Top" HorizontalAlignment="Right" Spacing="6" Width="420" Margin="0,8,8,0" />
        </Grid>

        <!-- Dock -->
        <Border Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,12" Padding="10,8" CornerRadius="18"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ItemsControl ItemsSource="{x:Bind ViewModel.DockItems}" TabFocusNavigation="Local">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DockItemViewModel">
                        <Button Command="{x:Bind OpenCommand}" Padding="12,8" Background="Transparent" BorderThickness="0" CornerRadius="12"
                                AutomationProperties.Name="{x:Bind DisplayName}" ToolTipService.ToolTip="{x:Bind Descriptor.Description}">
                            <StackPanel Spacing="4" HorizontalAlignment="Center" MinWidth="64">
                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="24" />
                                <TextBlock Text="{x:Bind DisplayName}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                           Visibility="{x:Bind h:Converters.ToVisibility(ShowLabel), Mode=OneWay}" />
                                <Ellipse Width="4" Height="4" HorizontalAlignment="Center" Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                         Opacity="{x:Bind h:Converters.ToOpacity(IsOpen), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>

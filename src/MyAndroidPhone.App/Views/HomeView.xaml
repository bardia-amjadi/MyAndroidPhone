<UserControl
    x:Class="MyAndroidPhone.Desktop.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MyAndroidPhone.Desktop.ViewModels"
    xmlns:h="using:MyAndroidPhone.Desktop.Helpers">

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="24" Padding="48,40,48,32" MaxWidth="1100" HorizontalAlignment="Center">
                <StackPanel Spacing="6">
                    <TextBlock Text="My Android Phone" Style="{StaticResource DisplayTextBlockStyle}" />
                    <TextBlock Text="Choose an instance to open its desktop, or create a new one for another phone."
                               Style="{StaticResource BodyTextBlockStyle}" Opacity="0.8" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.CreateCommand}" Padding="18,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Create new instance" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Spacing="8" Visibility="{x:Bind h:Converters.ToVisibility(ViewModel.NoInstances), Mode=OneWay}"
                            Padding="0,24" HorizontalAlignment="Left">
                    <FontIcon Glyph="&#xE8EA;" FontSize="44" Opacity="0.5" HorizontalAlignment="Left" />
                    <TextBlock Text="No instances yet" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" MaxWidth="520" Opacity="0.8"
                               Text="An instance is a saved desktop for one phone. Create one, connect your phone by USB or over the network, and give it a name, icon and theme." />
                </StackPanel>

                <GridView ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                          Visibility="{x:Bind h:Converters.ToVisibility(ViewModel.HasInstances), Mode=OneWay}" AutomationProperties.Name="Instances">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:InstanceItemViewModel">
                            <Grid Width="300" Padding="16" RowSpacing="10" CornerRadius="14"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="14" Background="{x:Bind AccentBrush}">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="26" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Model}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Padding="6" Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
                                            AutomationProperties.Name="Instance options">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Open" Tag="{x:Bind}" Click="OnOpenClick" />
                                                <MenuFlyoutItem Text="Remove" Tag="{x:Bind}" Click="OnRemoveClick" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <StackPanel Grid.Row="1" Spacing="2">
                                    <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind LastOpenedText}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <TextBlock Text="{x:Bind ViewModel.ToolSummary, Mode=OneWay}" Opacity="0.55" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Pop-up wizard layer -->
        <Grid x:Name="WizardLayer" Visibility="Collapsed" Background="#99000000">
            <Border x:Name="WizardCard" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" BorderThickness="1"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <ContentPresenter x:Name="WizardHost" />
            </Border>
        </Grid>

        <StackPanel x:Name="NotificationHost" VerticalAlignment="Top" HorizontalAlignment="Right" Spacing="6" Width="420" Margin="0,12,12,0" />
    </Grid>
</UserControl>

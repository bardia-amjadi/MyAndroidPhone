<UserControl
    x:Class="MyAndroidPhone.Desktop.Views.StartMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MyAndroidPhone.Desktop.ViewModels"
    xmlns:h="using:MyAndroidPhone.Desktop.Helpers">

    <Grid>
        <!-- Clicking outside the panel closes it -->
        <Grid Background="Transparent" Tapped="OnBackdropTapped" />

        <Border x:Name="Panel" Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                CornerRadius="16" Padding="16" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">

                    <!-- Header -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Device Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.InstanceName, Mode=OneWay}" Opacity="0.7" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                            <Button Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Read the phone again" AutomationProperties.Name="Refresh">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Content="Connections..." Command="{x:Bind ViewModel.OpenConnectionsCommand}" />
                        </StackPanel>
                    </Grid>

                    <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Warning"
                             Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />

                    <!-- Phone information -->
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Padding="12" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE83F;" FontSize="14" />
                                    <TextBlock Text="Battery" Opacity="0.7" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.BatteryText, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                <ProgressBar Value="{x:Bind ViewModel.BatteryPercent, Mode=OneWay}" Maximum="100" />
                                <TextBlock Text="{x:Bind ViewModel.BatteryDetail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Padding="12" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE701;" FontSize="14" />
                                    <TextBlock Text="Wi-Fi" Opacity="0.7" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.WifiText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.WifiDetail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Padding="12" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="14" />
                                    <TextBlock Text="Storage" Opacity="0.7" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.StorageText, Mode=OneWay}" TextWrapping="Wrap" />
                                <ProgressBar Value="{x:Bind ViewModel.StoragePercent, Mode=OneWay}" Maximum="100" />
                                <TextBlock Text="{x:Bind ViewModel.StorageDetail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Padding="12" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE950;" FontSize="14" />
                                    <TextBlock Text="Memory" Opacity="0.7" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" TextWrapping="Wrap" />
                                <ProgressBar Value="{x:Bind ViewModel.MemoryPercent, Mode=OneWay}" Maximum="100" />
                                <TextBlock Text="{x:Bind ViewModel.MemoryDetail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6">
                        <Run Text="{x:Bind ViewModel.UptimeText, Mode=OneWay}" /><Run Text="   " /><Run Text="{x:Bind ViewModel.UpdatedText, Mode=OneWay}" />
                    </TextBlock>

                    <!-- Launchers -->
                    <TextBlock Text="Apps" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <GridView ItemsSource="{x:Bind ViewModel.Launchers}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnLauncherClick"
                              AutomationProperties.Name="Apps">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LauncherItem">
                                <StackPanel Width="96" Spacing="6" Padding="4,8">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="26" />
                                    <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- Running windows (task manager) -->
                    <TextBlock Text="Running" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="No windows are open." Opacity="0.6"
                               Visibility="{x:Bind h:Converters.ToVisibility(ViewModel.HasNoWindows), Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Windows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RunningWindowItem">
                                <Grid ColumnSpacing="10" Padding="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind StateText}" Opacity="0.6" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Content="Show" Command="{x:Bind FocusCommand}" Padding="10,3" />
                                    <Button Grid.Column="4" Content="End" Command="{x:Bind CloseCommand}" Padding="10,3" ToolTipService.ToolTip="Close this window" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Button Content="Switch instance" Command="{x:Bind ViewModel.SwitchInstanceCommand}" HorizontalAlignment="Left" />
                        <Button Content="Close" Command="{x:Bind ViewModel.CloseCommand}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

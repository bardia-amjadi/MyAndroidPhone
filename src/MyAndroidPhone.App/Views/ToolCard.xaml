<UserControl
    x:Class="MyAndroidPhone.Desktop.Views.ToolCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MyAndroidPhone.Desktop.ViewModels"
    xmlns:h="using:MyAndroidPhone.Desktop.Helpers">

    <Border Padding="16" CornerRadius="10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="6">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Item.Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind Item.IsChecking, Mode=OneWay}" Visibility="{x:Bind h:Converters.ToVisibility(Item.IsChecking), Mode=OneWay}" />
                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind h:Converters.ToVisibility(Item.IsFound), Mode=OneWay}" />
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind h:Converters.ToVisibility(Item.IsInvalid), Mode=OneWay}" />
                    <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind h:Converters.ToVisibility(Item.IsMissing), Mode=OneWay}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{x:Bind Item.Description, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.85" />
            <TextBlock Text="{x:Bind Item.VersionText, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind Item.LocationText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock Text="{x:Bind Item.OperationsText, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock Text="{x:Bind Item.DependsOnText, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock Text="{x:Bind Item.LicenseText, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
            <InfoBar IsOpen="{x:Bind Item.HasMessage, Mode=OneWay}" IsClosable="False" Severity="Warning"
                     Message="{x:Bind Item.Message, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <Button Content="Locate executable…" Command="{x:Bind Item.LocateCommand}" />
                <Button Content="Use automatic detection" Command="{x:Bind Item.UseAutomaticCommand}"
                        Visibility="{x:Bind h:Converters.ToVisibility(Item.HasConfiguredPath), Mode=OneWay}" />
                <Button Content="Open folder" Command="{x:Bind Item.OpenFolderCommand}"
                        Visibility="{x:Bind h:Converters.ToVisibility(Item.HasPath), Mode=OneWay}" />
                <HyperlinkButton Content="Download page" NavigateUri="{x:Bind Item.DownloadPageUri, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

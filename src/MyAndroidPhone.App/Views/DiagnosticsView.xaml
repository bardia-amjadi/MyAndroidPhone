<UserControl
    x:Class="MyAndroidPhone.Desktop.Views.DiagnosticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Logs and Diagnostics" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            <Button Content="Export report…" Command="{x:Bind ViewModel.ExportCommand}" />
            <Button Content="Open logs folder" Command="{x:Bind ViewModel.OpenLogsFolderCommand}" />
        </StackPanel>

        <Pivot Grid.Row="1">
            <PivotItem Header="Report">
                <TextBox Text="{x:Bind ViewModel.ReportText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </PivotItem>
            <PivotItem Header="Recent log">
                <TextBox Text="{x:Bind ViewModel.RecentLogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>

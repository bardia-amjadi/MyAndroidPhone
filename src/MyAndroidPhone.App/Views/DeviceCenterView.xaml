<UserControl
    x:Class="MyAndroidPhone.Desktop.Views.DeviceCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MyAndroidPhone.Desktop.ViewModels"
    xmlns:h="using:MyAndroidPhone.Desktop.Helpers">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.85" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                <Button Content="Restart adb" Command="{x:Bind ViewModel.RestartServerCommand}" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView ItemsSource="{x:Bind ViewModel.Items}" SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                      SelectionMode="Single" AutomationProperties.Name="Devices">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceItemViewModel">
                        <Grid ColumnSpacing="10" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind IconGlyph}" Foreground="{x:Bind AccentBrush}" FontSize="22" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="14" Padding="0,0,12,0">

                    <StackPanel Spacing="10" Visibility="{x:Bind h:Converters.ToVisibility(ViewModel.HasSelection), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <InfoBar IsOpen="{x:Bind ViewModel.SelectedHasGuidance, Mode=OneWay}" IsClosable="False" Severity="Warning"
                                 Message="{x:Bind ViewModel.SelectedGuidance, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedDetails, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <TextBlock Text="What this device supports" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedCapabilities, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.85" />

                        <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                        <TextBox Header="Display name (leave empty for the automatic name)" MaxLength="60"
                                 Text="{x:Bind ViewModel.EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox Header="Icon" ItemsSource="{x:Bind ViewModel.IconOptions}" SelectedIndex="{x:Bind ViewModel.EditIconIndex, Mode=TwoWay}" MinWidth="160">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChoiceOption">
                                        <TextBlock Text="{x:Bind Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Header="Accent color" ItemsSource="{x:Bind ViewModel.ColorOptions}" SelectedIndex="{x:Bind ViewModel.EditColorIndex, Mode=TwoWay}" MinWidth="160">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChoiceOption">
                                        <TextBlock Text="{x:Bind Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                            <Button Content="Forget saved settings" Command="{x:Bind ViewModel.ForgetCommand}" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind h:Converters.ToVisibility(ViewModel.SelectedCanSwitchToWifi), Mode=OneWay}">
                            <Button Content="Switch to Wi-Fi (adb tcpip)" Command="{x:Bind ViewModel.SwitchToWifiCommand}" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                            <TextBlock Text="Keep the cable plugged in, then press Connect below." VerticalAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                        <Button Content="Disconnect this Wi-Fi device" Command="{x:Bind ViewModel.DisconnectCommand}" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                Visibility="{x:Bind h:Converters.ToVisibility(ViewModel.SelectedCanDisconnect), Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Text="Connect with a USB cable" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="1. On the phone open Settings > About phone and tap Build number 7 times to enable Developer options.&#x0A;2. Open Settings > System > Developer options and turn on USB debugging.&#x0A;3. Plug in the cable and choose File transfer if asked for a USB mode.&#x0A;4. Unlock the phone and tap Allow on the debugging prompt. The device then shows as Ready here.&#x0A;If the phone never appears, install the phone maker's USB driver (or Google's USB driver), try another cable or port, then press Restart adb." />

                    <TextBlock Text="Connect over Wi-Fi" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="Android 11 or later: turn on Developer options > Wireless debugging (phone and PC on the same network), tap Pair device with pairing code, and enter the address and code shown. Then enter the address and port from the main Wireless debugging screen, which is a different port. Older Android: connect by USB first and use Switch to Wi-Fi above." />
                    <TextBox Header="Pairing address (IP:port from the pairing dialog)" PlaceholderText="192.168.1.20:40123"
                             Text="{x:Bind ViewModel.PairEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox Header="Pairing code (6 digits)" MaxLength="6"
                                 Password="{x:Bind ViewModel.PairCode, Mode=TwoWay}" />
                    <Button Content="Pair" Command="{x:Bind ViewModel.PairCommand}" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                    <TextBox Header="Connect address (IP:port from the Wireless debugging screen)" PlaceholderText="192.168.1.20:37215"
                             Text="{x:Bind ViewModel.ConnectEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Connect" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ConnectCommand}" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                               Text="Only addresses you type here are contacted. The app never scans your network." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

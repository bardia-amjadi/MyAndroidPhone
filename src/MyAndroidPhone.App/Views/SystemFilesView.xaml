<UserControl
    x:Class="MyAndroidPhone.Desktop.Views.SystemFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MyAndroidPhone.Desktop.ViewModels"
    xmlns:h="using:MyAndroidPhone.Desktop.Helpers">

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsOpen="False" Background="Transparent">
            <AppBarButton Icon="Home" Label="Home" Command="{x:Bind ViewModel.GoHomeCommand}" ToolTipService.ToolTip="Back to / (.android and .system)" />
            <AppBarButton Icon="Up" Label="Up" Command="{x:Bind ViewModel.GoUpCommand}" />
            <AppBarButton Icon="Refresh" Label="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            <AppBarSeparator />
            <AppBarButton Icon="NewFolder" Label="New folder" Command="{x:Bind ViewModel.NewFolderCommand}" />
            <AppBarButton Icon="OpenFile" Label="Open in Notepad" Command="{x:Bind ViewModel.OpenInNotepadCommand}" />
            <AppBarButton Icon="Delete" Label="Delete" Command="{x:Bind ViewModel.DeleteCommand}" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Rename" Label="Rename" Command="{x:Bind ViewModel.RenameCommand}" />
                <AppBarButton Icon="OpenLocal" Label="Show in Windows Explorer" Command="{x:Bind ViewModel.ShowInWindowsCommand}" />
                <AppBarButton Label="Open Terminal" Command="{x:Bind ViewModel.OpenTerminalHereCommand}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
            <TextBlock Text="{x:Bind ViewModel.PathText, Mode=OneWay}" FontWeight="SemiBold" />
            <TextBlock Text="the instance's own space on this PC" Opacity="0.55" />
        </StackPanel>

        <InfoBar Grid.Row="2" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                 Title="Could not complete" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />

        <Grid Grid.Row="3">
            <ListView x:Name="FileList" ItemsSource="{x:Bind ViewModel.Entries}" SelectionMode="Extended"
                      IsDoubleTapEnabled="True" DoubleTapped="OnListDoubleTapped" SelectionChanged="OnSelectionChanged"
                      AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" AutomationProperties.Name="Files in .system">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileEntryViewModel">
                        <Grid ColumnSpacing="8" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Opacity="0.8" />
                            <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Open in Notepad" Command="{x:Bind ViewModel.OpenInNotepadCommand}" />
                        <MenuFlyoutItem Text="Show in Windows Explorer" Command="{x:Bind ViewModel.ShowInWindowsCommand}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="New folder" Command="{x:Bind ViewModel.NewFolderCommand}" />
                        <MenuFlyoutItem Text="Rename" Command="{x:Bind ViewModel.RenameCommand}" />
                        <MenuFlyoutItem Text="Delete" Command="{x:Bind ViewModel.DeleteCommand}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
                        <MenuFlyoutItem Text="Open Terminal" Command="{x:Bind ViewModel.OpenTerminalHereCommand}" />
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>
            <ProgressRing Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>

        <TextBlock Grid.Row="4" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" Opacity="0.7">
            <Run Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" /><Run Text="   " /><Run Text="{x:Bind ViewModel.RootText}" />
        </TextBlock>
    </Grid>
</UserControl>

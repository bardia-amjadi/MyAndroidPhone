<UserControl
    x:Class="MyAndroidPhone.Desktop.Views.TransferCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MyAndroidPhone.Desktop.ViewModels"
    xmlns:h="using:MyAndroidPhone.Desktop.Helpers">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.85" />
            <Button Grid.Column="1" Content="Clear finished" Command="{x:Bind ViewModel.ClearFinishedCommand}" />
        </Grid>

        <TextBlock Grid.Row="1" Text="Transfers you start from File Explorer appear here." Opacity="0.7"
                   Visibility="{x:Bind h:Converters.ToVisibility(ViewModel.IsEmpty), Mode=OneWay}" />

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" AutomationProperties.Name="Transfers">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TransferItemViewModel">
                    <Grid ColumnSpacing="12" Padding="0,8" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon Glyph="{x:Bind DirectionGlyph}" FontSize="20" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Destination}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind StateText}" VerticalAlignment="Top" />
                        <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100"
                                     Value="{x:Bind Percent}" IsIndeterminate="{x:Bind IsIndeterminate}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind Detail}" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.85" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind FailureText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Style="{StaticResource CaptionTextBlockStyle}" Visibility="{x:Bind h:Converters.ToVisibility(HasFailures)}" />
                        <StackPanel Grid.Row="2" Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                            <Button Content="Cancel" Tag="{x:Bind}" Click="OnCancel" Visibility="{x:Bind h:Converters.ToVisibility(CanCancel)}" />
                            <Button Content="Retry" Tag="{x:Bind}" Click="OnRetry" Visibility="{x:Bind h:Converters.ToVisibility(CanRetry)}" />
                            <Button Content="Open folder" Tag="{x:Bind}" Click="OnOpenFolder" Visibility="{x:Bind h:Converters.ToVisibility(CanOpenFolder)}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
